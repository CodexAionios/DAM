# DAM deployment configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored - never commit real keys.
# Real environment variables take precedence over this file, so CI can set
# them directly without one.
#
# Nothing here is needed for local development: `--network localhost` uses the
# Hardhat node's own funded accounts and deploys a mock reward token.


# ---------------------------------------------------------------------------
# Signing and networks (public networks only)
# ---------------------------------------------------------------------------

# The account that sends the deployment transactions and initially owns every
# contract. It must hold native gas on the target chain, and enough reward
# tokens to fund the reward pool (see REWARD_POOL_AMOUNT).
DEPLOYER_PRIVATE_KEY=

# One RPC endpoint per network you intend to use.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Any other EVM chain, without editing hardhat.config.js: `--network custom`.
CUSTOM_RPC_URL=
CUSTOM_CHAIN_ID=


# ---------------------------------------------------------------------------
# Roles - separate these on any real deployment
# ---------------------------------------------------------------------------
# The deploy script defaults all of them to the deployer, which is fine locally
# and wrong anywhere else: one leaked key would control telemetry, fraud
# accusations and consensus difficulty at once.

# Takes ownership of every administered contract once deployment finishes.
# Use a multisig. Ownership transfer is two-step, so this address must then
# call acceptOwnership() on each contract before it is actually in control.
ADMIN_ADDRESS=

# Attests node telemetry (PoEEnergyMarket.reportNodeMetrics) and task
# completion (MLTaskManager.reportCompletion). A node cannot grade its own
# work, so this is a trusted third party - not any node's key.
REPORTER_ADDRESS=

# Comma-separated addresses allowed to file fraud reports. A node is
# blacklisted once FRAUD_BLACKLIST_THRESHOLD *distinct* reporters accuse it,
# so a threshold above the number of reporters can never trigger.
FRAUD_REPORTERS=
FRAUD_BLACKLIST_THRESHOLD=


# ---------------------------------------------------------------------------
# Reward token and pool
# ---------------------------------------------------------------------------

# Required on public networks: the ERC20 paid out as block rewards. On local
# networks a mock token is deployed instead and this is ignored.
REWARD_TOKEN_ADDRESS=

# Transferred from the deployer to PoEGreenNode so it can pay rewards.
# In wei-style base units. Default 100000e18.
REWARD_POOL_AMOUNT=

# Base reward per committed block, before efficiency scaling. Default 10e18.
BASE_BLOCK_REWARD=


# ---------------------------------------------------------------------------
# Protocol parameters (all optional - sensible defaults in the deploy script)
# ---------------------------------------------------------------------------

# Minimum PoE score a node needs to bid or commit blocks.
EFFICIENCY_THRESHOLD=

# Tensor difficulty, in fixed point at TENSOR_SCALE = 1e6.
DIFFICULTY_TARGET=
NORM_TARGET=

# Proof-of-work target; higher is easier. The contract retargets from here.
HASH_DIFFICULTY=

# Automatic retargeting: committed blocks per epoch, and seconds per block.
# RETARGET_INTERVAL=0 pins difficulty and leaves only the manual override.
RETARGET_INTERVAL=
TARGET_BLOCK_TIME=

# Entropic overhead bounds, in seconds.
MAX_ENTROPIC_OVERHEAD=
REFERENCE_TIME=


# ---------------------------------------------------------------------------
# Node client
# ---------------------------------------------------------------------------

# Signing key for node_client/*. Without it the client falls back to Hardhat's
# public dev key and refuses to sign against any chain that is not known-local.
DAM_NODE_PRIVATE_KEY=

# RPC endpoint the Python client talks to.
DAM_RPC_URL=

# Which deployment the client loads from frontend/contracts/deployments/.
# Defaults to whichever was deployed most recently.
DAM_NETWORK=
